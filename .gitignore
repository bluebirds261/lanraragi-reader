# ========== Gradle 构建产物 ==========
.gradle/
build/
**/build/
# Gradle 自动生成的 daemon 配置(机器相关)
/gradle/gradle-daemon-jvm.properties

# ========== 本机配置(含 SDK 路径,严禁上传) ==========
local.properties

# ========== IDE 配置(含机器相关的绝对路径,不共享) ==========
.idea/
*.iml
# Android Studio / IntelliJ 的本地索引与 APK 分析缓存
.idea/caches/
.idea/libraries/
*.apk.idsig

# ========== Kotlin 编译会话缓存 ==========
.kotlin/
.kotlin/**

# ========== 打包产物与签名文件 ==========
*.apk
*.aab
*.ap_
*.keystore
*.jks
*.p12
*.key
/app/release/

# ========== JVM 崩溃日志 ==========
hs_err_pid*.log
replay_pid*.log
*.hprof
*.dump

# ========== 本地构建日志与验收临时目录（打包源码时不应进包） ==========
# 根目录下的任何 .log 都是本地构建/调试输出（含 adb、gradle 重定向日志），一律不进仓库。
# 曾用 `/build-*.log` 这种窄规则，结果 agp933.log 之类漏网被误提交，故放宽到 `/*.log`。
/*.log
/deps-*.txt
/dependency-*.txt
.verify/
# 打包源码时生成的中间产物（只忽略仓库根目录下的压缩包，测试夹具里的 zip 不受影响）
/dist/
/*.zip

# ========== 原生构建产物 ==========
.externalNativeBuild/
.cxx/

# ========== 测试/模拟器截图 ==========
captures/

# ========== 操作系统垃圾文件 ==========
.DS_Store
Thumbs.db
Desktop.ini
